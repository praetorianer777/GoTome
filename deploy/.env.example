# Copy to .env beside docker-compose.yml and uncomment what you change; Docker
# Compose reads it from this folder. Every value shown is the default.

# The app's image. Pin a release to choose when you upgrade: change the version
# here, then `docker compose pull && docker compose up -d`. Left unset, it is
# ghcr.io/praetorianer777/gotome:latest, which moves with every release.
# GOTOME_IMAGE=ghcr.io/praetorianer777/gotome:0.1.1

# The port on this machine the web app answers on.
# GOTOME_PORT=8080

# How often every library's folder is looked through for changes, a minute or
# more (30m, 6h); 0 leaves scanning to the "Scan now" button.
# GOTOME_SCAN_INTERVAL=6h

# The largest file one upload may carry, in MiB.
# GOTOME_UPLOAD_LIMIT_MB=4096

# true asks no metadata source on the internet and downloads no language model,
# for a server that must not reach out.
# GOTOME_OFFLINE=false

# debug, info, warn or error.
# GOTOME_LOG_LEVEL=info

# true lets everyone sign in with a password even where the settings turned
# that off: the way back in when the identity provider is gone.
# GOTOME_FORCE_PASSWORD_LOGIN=false

# production, or development while working on GOtome itself.
# GOTOME_ENV=production

# Only for an installation that set its own database password before: init
# then writes that one instead of a random one. Leave it unset otherwise.
# POSTGRES_PASSWORD=
