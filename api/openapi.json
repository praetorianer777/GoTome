{
  "openapi": "3.1.0",
  "info": {
    "title": "GOtome API",
    "version": "1",
    "description": "Every failure is answered with the ErrorEnvelope, whatever the status."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "libraries"
    },
    {
      "name": "system"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in with user name and password",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "End the session",
        "tags": [
          "auth"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Who is signed in",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "signed-in"
      }
    },
    "/libraries": {
      "get": {
        "operationId": "listLibraries",
        "summary": "The libraries the caller may see",
        "tags": [
          "libraries"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryList"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "library:read"
      },
      "post": {
        "operationId": "createLibrary",
        "summary": "Add a library",
        "tags": [
          "libraries"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLibraryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "storage:manage"
      }
    },
    "/libraries/{libraryId}": {
      "delete": {
        "operationId": "deleteLibrary",
        "summary": "Remove a library from GOtome; its folder and files stay",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "storage:manage"
      },
      "get": {
        "operationId": "getLibrary",
        "summary": "One library, if the caller may see it",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "library:read"
      },
      "patch": {
        "operationId": "updateLibrary",
        "summary": "Change a library's name, visibility or whether GOtome may write to it",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLibraryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryResponse"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "storage:manage"
      }
    },
    "/libraries/{libraryId}/members": {
      "get": {
        "operationId": "listLibraryMembers",
        "summary": "Who may see a private library besides its owner",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberList"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "storage:manage"
      }
    },
    "/libraries/{libraryId}/members/{userId}": {
      "delete": {
        "operationId": "removeLibraryMember",
        "summary": "Take a private library away from a user again",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "storage:manage"
      },
      "put": {
        "operationId": "addLibraryMember",
        "summary": "Let a user see a private library",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "storage:manage"
      }
    },
    "/libraries/{libraryId}/scans": {
      "post": {
        "operationId": "scanLibrary",
        "summary": "Look through a library's folder for new, changed and missing files",
        "tags": [
          "libraries"
        ],
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scan"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "x-permission": "index:rebuild"
      }
    },
    "/setup": {
      "get": {
        "operationId": "getSetup",
        "summary": "Whether the first account still has to be created",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-permission": "public"
      },
      "post": {
        "operationId": "completeSetup",
        "summary": "Create the first account, an administrator, and sign in as it",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "summary": "Which build of GOtome is running",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildInfo"
                }
              }
            }
          },
          "default": {
            "description": "The request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    }
  },
  "components": {
    "schemas": {
      "APIError": {
        "type": "object",
        "description": "Why a request failed.",
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "BuildInfo": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version"
        ]
      },
      "CreateLibraryRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rootPath": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "mode",
          "visibility"
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "library:read",
                "personal:manage",
                "books:upload",
                "metadata:edit",
                "index:rebuild",
                "users:manage",
                "settings:manage",
                "storage:manage"
              ]
            }
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "permissions"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/APIError"
          }
        },
        "required": [
          "error"
        ]
      },
      "LibraryList": {
        "type": "object",
        "properties": {
          "libraries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryResponse"
            }
          }
        },
        "required": [
          "libraries"
        ]
      },
      "LibraryResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lastScan": {
            "$ref": "#/components/schemas/Scan"
          },
          "mode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "rootPath": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "mode",
          "writable",
          "visibility",
          "createdAt"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "addedAt"
        ]
      },
      "MemberList": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          }
        },
        "required": [
          "members"
        ]
      },
      "Scan": {
        "type": "object",
        "properties": {
          "booksAdded": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "filesAdded": {
            "type": "integer"
          },
          "filesChanged": {
            "type": "integer"
          },
          "filesMissing": {
            "type": "integer"
          },
          "filesMoved": {
            "type": "integer"
          },
          "filesRestored": {
            "type": "integer"
          },
          "filesSeen": {
            "type": "integer"
          },
          "filesSkipped": {
            "type": "integer"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "libraryId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "libraryId",
          "state",
          "requestedAt",
          "filesSeen",
          "filesAdded",
          "filesChanged",
          "filesMoved",
          "filesRestored",
          "filesMissing",
          "filesSkipped",
          "booksAdded"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "properties": {
          "needed": {
            "type": "boolean"
          }
        },
        "required": [
          "needed"
        ]
      },
      "UpdateLibraryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "writable": {
            "type": "boolean"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ]
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gotome_session",
        "description": "The session cookie that signing in sets."
      }
    }
  }
}
